// ── Throughput Column ─────────────────────────────────────────────────────────
// Reports MB/s = GetDataSizeBytes() / Mean_ns × 10⁹ / 2²⁰
// Each benchmark class exposes public static long GetDataSizeBytes() which is
// called once in the host process via reflection and cached per type.

/// <summary>
/// Custom BenchmarkDotNet column that reports throughput in MB/s.
/// Requires each benchmark class to expose <c>public static long GetDataSizeBytes()</c>.
/// </summary>
public sealed class ThroughputColumn : IColumn
{
    public static readonly ThroughputColumn Default = new ThroughputColumn();

    private readonly Dictionary<Type, long> _cache = new();

    public string        Id                  => nameof(ThroughputColumn);
    public string        ColumnName          => "MB/s";
    public bool          AlwaysShow          => true;
    public ColumnCategory Category           => ColumnCategory.Custom;
    public int           PriorityInCategory  => 1;
    public bool          IsNumeric           => true;
    public UnitType      UnitType            => UnitType.Dimensionless;
    public string        Legend              => "Throughput: DataSizeBytes / Mean (MB/s)";

    public bool IsDefault(Summary s, BenchmarkCase b) => false;
    public bool IsAvailable(Summary s) => true;

    public string GetValue(Summary summary, BenchmarkCase benchmarkCase)
        => GetValue(summary, benchmarkCase, SummaryStyle.Default);

    public string GetValue(Summary summary, BenchmarkCase benchmarkCase, SummaryStyle style)
    {
        var report = summary[benchmarkCase];
        if (report?.ResultStatistics == null) return "N/A";

        var type = benchmarkCase.Descriptor.Type;
        if (!_cache.TryGetValue(type, out var dataSize))
        {
            var method = type.GetMethod("GetDataSizeBytes",
                BindingFlags.Public | BindingFlags.Static);
            dataSize = method is not null ? (long)method.Invoke(null, null)! : -1L;
            _cache[type] = dataSize;
        }
        if (dataSize <= 0) return "N/A";

        double mbPerSec = dataSize * 1_000_000_000.0 / (report.ResultStatistics.Mean * 1_048_576.0);
        return $"{mbPerSec:F1}";
    }
}

/// <summary>
/// BenchmarkDotNet config: inherits all defaults and appends <see cref="ThroughputColumn"/>.
/// Applied via <c>[Config(typeof(BenchConfig))]</c> on every benchmark class.
/// </summary>
public sealed class BenchConfig : ManualConfig
{
    public BenchConfig()
    {
        AddColumn(ThroughputColumn.Default);
    }
}
